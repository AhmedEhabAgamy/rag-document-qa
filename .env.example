# LLM — Groq's free tier (get a key at console.groq.com, no card needed)
GROQ_API_KEY=your-groq-key-here
LLM_MODEL=llama-3.1-8b-instant

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG tuning
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# Storage
CHROMA_DIR=data/chroma
UPLOAD_DIR=data/uploads
LOG_DIR=logs
